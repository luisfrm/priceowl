# Environment: local | development | production
APP_ENV=local

# SQLite (used when APP_ENV is local or development)
SQLITE_DATABASE_URL=sqlite:///priceowl.db

# PostgreSQL (used when APP_ENV is production or other)
# POSTGRES_USER=priceowl
# POSTGRES_PASSWORD=priceowl123
# POSTGRES_DB=priceowl
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional manual override (takes precedence over both above)
# DATABASE_URL=sqlite:///path/to/db.db

TELEGRAM_TOKEN=

MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
EBAY_APP_ID=
SCRAPERAPI_KEY=